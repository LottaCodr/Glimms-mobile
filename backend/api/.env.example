# ── App ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── Database (Supabase Postgres) ──────────────────────────────────────────────
# Local: the Postgres container from `npm run services:up`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glimms
#
# Supabase: Dashboard → Connect → "Session pooler" (IPv4, port 5432) or the
# direct connection (IPv6 only unless you have the IPv4 add-on):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Do not use the transaction pooler (port 6543) for `npm run db:migrate`.
#
# TLS: disable | require | verify-full. Defaults to "disable" for localhost and
# "require" otherwise. For verify-full, download the CA from Supabase
# (Database → Settings → SSL) and put the PEM in DATABASE_CA_CERT (\n-escaped).
DATABASE_SSL=
DATABASE_CA_CERT=
# Connections held by this process. Keep (instances × pool) under the Supabase limit.
DATABASE_POOL_MAX=10
# Apply pending supabase/migrations at boot. Prefer `npm run db:migrate:prod`
# as a release step when running more than one instance.
DB_MIGRATE_ON_START=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=super-secret-change-in-production-min-32-chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=another-secret-change-in-production-min-32-chars
REFRESH_TOKEN_EXPIRES_IN=7d

# ── Bcrypt ────────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ── AWS / S3 ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=glimms-images
S3_PRESIGN_EXPIRY_SECONDS=900

# ── AI Services (Python FastAPI) ───────────────────────────────────────────────
# Option A — single gateway (all 8 services behind one origin, path-prefixed).
# This is how the hosted deployment is shaped: /object-detection/…, /quality-guard/… etc.
# AI_GATEWAY_URL=https://glimms-ai.onrender.com
AI_GATEWAY_URL=
#
# Option B — one URL per service. Any value set here overrides AI_GATEWAY_URL for
# that service. Local dev (docker-compose): http://localhost:8001 etc.
# Production (private DNS / k8s): http://object-detection:8001 — never expose to frontend.
# Leave blank to fall back to AI_GATEWAY_URL, then to http://localhost:800X.
AI_OBJECT_DETECTION_URL=
AI_ATTRIBUTE_EXTRACTOR_URL=
AI_EMBEDDING_ENGINE_URL=
AI_PERMUTATION_ENGINE_URL=
AI_LLM_REASONING_URL=
AI_MOCKUP_COMPOSITOR_URL=
AI_QUALITY_GUARD_URL=
AI_CONTEXT_INFERENCE_URL=
# Service-to-service auth. MUST match AI_INTERNAL_TOKEN on the Glimms deployment;
# that deployment refuses to boot without one when GLIMMS_ENV=production, and then
# every endpoint except /livez returns 401 without this header.
# Generate with: openssl rand -hex 32     (alias: GLIMMS_INTERNAL_TOKEN)
AI_INTERNAL_TOKEN=
# Scales every AI request timeout. Free hosting tiers (Render) sleep when idle and
# take ~30-60s to wake, which exceeds the default per-call timeouts — use 4-6 there.
AI_TIMEOUT_MULTIPLIER=1
# Let GET /health/ready pass when services are reachable but running fallback
# backends (model_loaded:false, in-memory vectors) — true for the lightweight build.
AI_ALLOW_DEGRADED=false
# Ceiling for any single AI call. The slow paths (/llm-reasoning/reason,
# /mockup-compositor/compose) need ~120s; a cold instance adds 30-60s.
GLIMMS_TIMEOUT_MS=120000
# Max in-flight upstream requests per process. One container runs all eight
# services (its own cap is MAX_CONCURRENT_UPSTREAM=16) — 4-8 avoids self-inflicted 502s.
AI_MAX_CONCURRENCY=6
# Retries after the first attempt, so 2 = up to 3 attempts. Only connection
# resets, 429 and 502/503/504 are retried; 4xx and fallback-blocked never are.
AI_MAX_RETRIES=2
# Consecutive failures before a service's circuit opens, and how long it stays open.
AI_BREAKER_THRESHOLD=5
AI_BREAKER_RESET_MS=30000

# ── Stripe ────────────────────────────────────────────────────────────────────
# Leave STRIPE_SECRET_KEY empty to switch billing off (GET /prices returns []).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# The plans for sale. These are the only prices checkout accepts, and the price
# on a subscription is what decides the user's tier.
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Where Stripe returns the user. These should be https pages (universal/app
# links, or pages that redirect into the app); the app also detects the result
# itself by polling when the in-app browser closes.
STRIPE_CHECKOUT_SUCCESS_URL=https://app.glimms.ai/dashboard?upgrade=success
STRIPE_CHECKOUT_CANCEL_URL=https://app.glimms.ai/upgrade?cancelled=true
STRIPE_PORTAL_RETURN_URL=https://app.glimms.ai/dashboard
STRIPE_FREE_SCAN_LIMIT=10
STRIPE_PREMIUM_SCAN_LIMIT=100

# ── Credo by eTranzact (naira cards + bank transfer) ─────────────────────────
# Keys: Credo dashboard → Settings → Developer → API Keys.
# Sandbox base URL https://api.credodemo.com, live https://api.credocentral.com.
# Webhook URL to enter in the dashboard: <PUBLIC_API_URL>/api/subscriptions/credo/webhook
# Credo has no recurring billing: one payment buys CREDO_PERIOD_DAYS of a tier.
# Leave the keys blank to switch naira payments off.
CREDO_PUBLIC_KEY=
CREDO_SECRET_KEY=
CREDO_BASE_URL=https://api.credodemo.com
CREDO_CURRENCY=NGN
# Price per period in kobo (250000 = NGN 2,500.00). A blank tier is not sold.
CREDO_PREMIUM_AMOUNT=
CREDO_PRO_AMOUNT=
CREDO_PERIOD_DAYS=30
# 0 = customer pays Credo's fee on top, 1 = fee comes out of the amount
CREDO_FEE_BEARER=1
CREDO_APP_RETURN_URL=glimms://billing/return

# ── Push notifications (Expo push service) ───────────────────────────────────
# Only needed when "Enhanced Security for Push Notifications" is enabled for
# the Expo project (expo.dev → project → Credentials → Access tokens).
EXPO_ACCESS_TOKEN=

# ── Public URL + social sign-in ──────────────────────────────────────────────
# Public https origin of this API. Emailed links (password reset, email
# confirmation) and the Credo return page use it. Required in production.
PUBLIC_API_URL=http://localhost:4000
# Comma-separated OAuth client ids whose tokens are accepted. Google: the iOS,
# Android and web client ids. Apple: the app bundle id (com.glimms.app).
# Blank = that sign-in method is switched off.
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=hello@glimms.ai

# ── Pinecone ──────────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_INDEX=glimms-style

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,exp://localhost:8081
# Production example: ALLOWED_ORIGINS=https://app.glimms.ai,https://www.glimms.ai

# ── Rate Limits ───────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── OpenWeather (optional) ────────────────────────────────────────────────────
OPENWEATHER_API_KEY=
