    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.0",
    "@types/react-test-renderer": "^19.3.1",
    "babel-preset-expo": "~57.0.6",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.4",
    "react-test-renderer": "^19.2.3",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
