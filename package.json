    "axios": "^1.18.1",
    "expo": "~57.0.12",
    "expo-calendar": "~57.0.1",
    "expo-camera": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-device": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.2",
    "expo-image-picker": "~57.0.9",
    "expo-linear-gradient": "~57.0.1",
