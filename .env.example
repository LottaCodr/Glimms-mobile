# ─── Glimms API ───────────────────────────────────────────────────────────────
# The hosted Render API is configured in app.json. Uncomment these values only
# to override it with a local or alternate backend. For a physical device, a
# local URL must be reachable by the phone; localhost is the phone itself.
# Add browser client origins to the backend's ALLOWED_ORIGINS when using web.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# EXPO_PUBLIC_WS_URL=http://192.168.1.10:4000

# Timeouts (ms, optional)
# EXPO_PUBLIC_API_TIMEOUT=20000
# EXPO_PUBLIC_UPLOAD_TIMEOUT=120000

# ─── Stripe price IDs (guide §12 — no backend /prices endpoint yet) ──────────
# EXPO_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxx
# EXPO_PUBLIC_STRIPE_PRO_PRICE_ID=price_yyyyyyyyyyyy
