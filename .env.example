# ─── Glimms API ───────────────────────────────────────────────────────────────
# Dev default: http://localhost:4000. For a physical device use your laptop's
# LAN IP (e.g. http://192.168.1.10:4000) and add that origin to the backend's
# ALLOWED_ORIGINS. See docs/FRONTEND_INTEGRATION.md §2.
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=http://localhost:4000

# Timeouts (ms, optional)
# EXPO_PUBLIC_API_TIMEOUT=20000
# EXPO_PUBLIC_UPLOAD_TIMEOUT=120000

# ─── Stripe price IDs (guide §12 — no backend /prices endpoint yet) ──────────
# EXPO_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxx
# EXPO_PUBLIC_STRIPE_PRO_PRICE_ID=price_yyyyyyyyyyyy
