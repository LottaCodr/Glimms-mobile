# ─── Glimms API ───────────────────────────────────────────────────────────────
# When these are omitted in development, the app derives the API host from
# Expo/Metro (and uses 10.0.2.2 on an Android emulator). Set them explicitly for
# production, Expo tunnel mode, or a backend that is not on the Metro machine.
# For a physical device, this URL must be reachable by the phone; localhost is
# the phone itself. Add the client origin to the backend's ALLOWED_ORIGINS.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# EXPO_PUBLIC_WS_URL=http://192.168.1.10:4000

# Timeouts (ms, optional)
# EXPO_PUBLIC_API_TIMEOUT=20000
# EXPO_PUBLIC_UPLOAD_TIMEOUT=120000

# ─── Stripe price IDs (guide §12 — no backend /prices endpoint yet) ──────────
# EXPO_PUBLIC_STRIPE_PREMIUM_PRICE_ID=price_xxxxxxxxxxxx
# EXPO_PUBLIC_STRIPE_PRO_PRICE_ID=price_yyyyyyyyyyyy
